# =============================================================================
# Upwork Discord Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your DISCORD_TOKEN.
# Note: UPWORK_BEARER_TOKEN and UPWORK_COOKIES are automatically generated 
# and refreshed by the bot using Selenium. You do not need to fill them manually.
# Channels and Search Queries are now managed dynamically in config.json.
# =============================================================================

# --- Discord Bot Token (REQUIRED) ---
# Get this from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your_discord_bot_token_here

# --- Optional: Request Tuning ---
# How many jobs to fetch per request per keyword (max is typically 50)
UPWORK_JOBS_PER_PAGE=20

# --- Polling Interval ---
# How often the bot checks for new jobs (in seconds).
# Warning: very low values may trigger Cloudflare blocks more often.
POLL_INTERVAL_SECONDS=20

# --- Upwork Authentication (AUTO-GENERATED) ---
# You do NOT need to set these manually. The bot will automatically extract 
# fresh tokens via Selenium when it starts or encounters a 403 error.
UPWORK_BEARER_TOKEN=
UPWORK_COOKIES=

# Terminal 1: python main.py --platform upwork
# Terminal 2: python main.py --platform guru
# Terminal 3: python main.py --platform freelancer
# Terminal 4: python main.py --platform peopleperhour