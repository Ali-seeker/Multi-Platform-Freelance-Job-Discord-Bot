# =============================================================================
# Upwork Job Scraper + Discord Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your real values.
# Get Upwork headers from Chrome DevTools -> Network tab -> find the GraphQL
# request to /api/graphql/v1?alias=visitorJobSearch -> copy from Request Headers.
#
# Your cookies and bearer token expire! If the scraper returns 401,
# re-capture them from a fresh browser session.
# =============================================================================

# --- Upwork Authentication ---
# Bearer token from the "authorization" request header
UPWORK_BEARER_TOKEN=Bearer oauth2v2_int_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Upwork Cookies ---
# Full cookie string from the "cookie" request header (one long string)
UPWORK_COOKIES=visitor_id=XXXXX; XSRF-TOKEN=XXXXX; ...paste full cookie string here...

# --- Search ---
# The search query to use when fetching jobs
UPWORK_SEARCH_QUERY=python developer

# --- Optional: Request Tuning ---
# How many jobs to fetch per request (max is typically 50)
UPWORK_JOBS_PER_PAGE=10

# =============================================================================
# Discord Bot (Phase 2)
# =============================================================================

# --- Discord Bot Token ---
# Get this from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your_discord_bot_token_here

# --- Discord Channel ID ---
# Right-click the channel in Discord -> "Copy Channel ID" (enable Developer Mode first)
DISCORD_CHANNEL_ID=1234567890123456789

# --- Polling Interval ---
# How often the bot checks for new jobs (in seconds). Default: 10
# Warning: very low values may get you rate-limited by Upwork
POLL_INTERVAL_SECONDS=10
